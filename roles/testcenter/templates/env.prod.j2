VERSION={{ testcenter_version }}

# Ingress
HOSTNAME={{ testcenter_hostname }}
HTTP_PORT={{ testcenter_http_port }}
HTTPS_PORT={{ testcenter_https_port }}
TLS_ENABLED={{ testcenter_tls_enabled }}
# Strict-Transport-Security response header
HSTS_ENABLED=true

# TLS Certificates Resolvers
## Choose '', if you handle certificates manually, or
## choose 'acme', if you want to use an ACME provider, like 'Let's Encrypt' or 'Sectigo'
TLS_CERTIFICATE_RESOLVER={{ testcenter_tls_certificate_resolver }}
TLS_ACME_CA_SERVER={{ testcenter_tls_acme_ca_server }}
TLS_ACME_EAB_KID={{ testcenter_tls_acme_eab_kid }}
TLS_ACME_EAB_HMAC_ENCODED={{ testcenter_tls_acme_eab_hmac_encoded }}
TLS_ACME_EMAIL={{ testcenter_tls_acme_email }}

# Images
## Dockerhub Proxy
DOCKERHUB_PROXY={{ testcenter_dockerhub_proxy }}
## Container Restart Policy. Allowed values are: no, always (default), on-failure, unless-stopped
RESTART_POLICY={{ testcenter_restart_policy }}

# Services
## Backend
BROADCASTER_ENABLED={{ testcenter_broadcaster_enabled }}
FILE_SERVER_ENABLED={{ testcenter_file_server_enabled }}
# BRUTE_FORCE_PROTECTION=admin login person
PASSWORD_SALT={{  testcenter_password_salt}}
{% if testcenter_version >= '18.2.0' %}
SERVER_KEY={{ testcenter_server_key }}
PASSWORD_MIN_LENGTH={{ testcenter_password_min_length }}
PASSWORD_PATTERN={{ testcenter_password_pattern }}
{% if testcenter_set_admin_init_password %}
ADMIN_INIT_PASSWORD={{ testcenter_password }}
{% else %}
ADMIN_INIT_PASSWORD=user123
{% endif %}
{% endif %}

## Cache Service
REDIS_PASSWORD={{ testcenter_redis_password }}
### Allowed memory usage for cache in byte. 2147483648 = 2GB. Default is 1GB.
REDIS_MEMORY_MAX={{ testcenter_redis_memory_max }}
### Should whole files be cached or only authentication tokens
REDIS_CACHE_FILES={{ testcenter_redis_cache_files }}

## Database
MYSQL_ROOT_PASSWORD={{ testcenter_mysql_root_password }}
MYSQL_DATABASE={{ testcenter_mysql_database }}
MYSQL_USER={{ testcenter_mysql_user }}
MYSQL_PASSWORD={{ testcenter_mysql_password }}
{% if testcenter_version >= '18.0.0' %}
MYSQL_BINLOG_EXPIRE_LOGS_SECONDS={{ testcenter_mysql_binlog_expire_logs_seconds }}
{% endif %}

# Network
## MTU Setting. Default is 1500, but Openstack actually uses 1442
DOCKER_DAEMON_MTU={{ testcenter_docker_daemon_mtu }}